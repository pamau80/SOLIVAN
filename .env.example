# Copia a .env.local
# Sin Supabase => modo local (demo)
# Con URL + anon key => runtimeMode=supabase (ver docs/SUPABASE_SETUP.md)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firma de cookie de sesión (local y puente)
SOLIVAN_SESSION_SECRET=cambia-este-secreto-largo

# Opcional: directorio del store JSON local
# SOLIVAN_DATA_DIR=/tmp/solivan-data
