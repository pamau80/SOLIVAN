# Copia a .env.local
# Sin Supabase => modo local
# Con URL + anon key => runtimeMode=supabase (ver docs/SUPABASE_SETUP.md)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obligatorio: firma de cookie de sesión (≥32 chars; genera uno propio)
# openssl rand -hex 32
SOLIVAN_SESSION_SECRET=

# Obligatorio en modo local: usuarios JSON (sin esto el login local falla)
# SOLIVAN_LOCAL_USERS=[{"email":"planner@example.com","password":"CHANGE_ME","fullName":"Planner","role":"planner"},{"email":"admin@example.com","password":"CHANGE_ME","fullName":"Admin","role":"admin"}]

# Opcional: listar emails (nunca passwords) en /login — solo fuera de producción
# SOLIVAN_EXPOSE_DEMO_USERS=true

# Opcional: directorio del store JSON local
# SOLIVAN_DATA_DIR=/tmp/solivan-data
