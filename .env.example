# Copia a .env.local
# Sin Supabase => modo local (demo)
# Con URL + anon key => runtimeMode=supabase (ver docs/SUPABASE_SETUP.md)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firma de cookie de sesión (≥32 chars en producción; no uses literales de ejemplo)
SOLIVAN_SESSION_SECRET=

# Opcional: exponer passwords demo en /api/auth/me (solo local de confianza)
# SOLIVAN_EXPOSE_DEMO_USERS=true

# Opcional: directorio del store JSON local
# SOLIVAN_DATA_DIR=/tmp/solivan-data
